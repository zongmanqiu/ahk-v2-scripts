# 脚本运行时产物（一律在 scripts/<名>/<名>/ 下，不进仓库；见开发指南 §1）
*.ini
selftest-result.txt
scan-report.txt
# 只忽略脚本同名产物区里的 history；仓库根 history/ 是 m221 版本历史清单，必须入库
scripts/*/*/history/
backup_*

# 杂项
__pycache__/
*.pyc
Thumbs.db
Desktop.ini
# 脚本运行时产物区（同名文件夹，按产物准则）
scripts/*/*/
!scripts/*/test/
!scripts/*/info/
dist/
# publish_version.py 每次 dry-run 都会写发布说明草稿，不入库
.temp/
